# Rendered only by the official nginx image entrypoint for the isolated trial.
# FUSTFS_LOCAL_API_UPSTREAM must be a complete, private trial endpoint such as
# http://127.0.0.1:18481 when the container uses host networking.
server {
  listen ${FUSTFS_WEB_LISTEN_PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Local-view data are served by the co-located A Agent or B Control service.
  # Requests are never redirected to an external URL and proxy errors remain
  # visible to the browser instead of being substituted with frozen fixture data.
  location ^~ /api/ {
    proxy_pass ${FUSTFS_LOCAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The typed frontend client creates a protocol-valid request identifier.
    # Preserve it: nginx's generated $request_id is not necessarily valid for
    # the control API and would turn otherwise valid browser requests into 400.
    proxy_set_header X-Request-ID $http_x_request_id;
    proxy_intercept_errors off;
  }

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok\n';
  }
}
