# Copy this file to .env.local and adjust it for the target environment.
# Do not commit credentials, tokens, or private endpoints.

# Application
VITE_APP_TITLE=FustFsDisk
VITE_APP_NAMESPACE=fustfsdisk-web
VITE_PORT=5666
VITE_BASE=/
VITE_ROUTER_HISTORY=hash

# API
VITE_GLOB_API_URL=/

# Development and diagnostics
VITE_NITRO_MOCK=false
VITE_DEVTOOLS=false
VITE_VISUALIZER=false
VITE_INJECT_APP_LOADING=true

# Production build
VITE_COMPRESS=none
VITE_PWA=false
VITE_ARCHIVER=false
