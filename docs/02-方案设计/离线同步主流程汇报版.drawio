<mxfile host="65bd71144e">
    <diagram id="three-party-report" name="两端与硬盘关系">
        <mxGraphModel dx="1167" dy="998" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="RustFS 离线同步：边缘端、运输硬盘与中心端的闭环关系" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#102a43;" parent="1" vertex="1">
                    <mxGeometry x="250" y="50" width="1420" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="edge" value="边缘端&#xa;Edge" style="swimlane;fontStyle=1;fontSize=22;horizontal=1;startSize=42;fillColor=#e8f4ff;swimlaneFillColor=#ffffff;strokeColor=#1677ff;" parent="1" vertex="1">
                    <mxGeometry x="80" y="205" width="440" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="edgeRustfs" value="本地 RustFS&#xa;源数据只读，不修改" style="shape=cylinder;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#f9f0ff;strokeColor=#722ed1;" parent="edge" vertex="1">
                    <mxGeometry x="105" y="85" width="220" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="edgeFlow" value="自动流程&#xa;插盘识别 → 扫描稳定数据&#xa;→ 加密写盘 → 封盘" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#d6e4ff;strokeColor=#1677ff;" parent="edge" vertex="1">
                    <mxGeometry x="65" y="230" width="310" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="disk" value="运输硬盘&#xa;离线数据交接介质" style="shape=cylinder3;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=#fff7e6;strokeColor=#fa8c16;" parent="1" vertex="1">
                    <mxGeometry x="745" y="245" width="430" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="lifecycle" value="生命周期&#xa;初始化 → 写盘中 → 已封盘 → 已导入 → 再初始化" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#fffbe6;strokeColor=#faad14;" parent="1" vertex="1">
                    <mxGeometry x="705" y="555" width="510" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="center" value="中心端&#xa;Center" style="swimlane;fontStyle=1;fontSize=22;horizontal=1;startSize=42;fillColor=#f6ffed;swimlaneFillColor=#ffffff;strokeColor=#52c41a;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="205" width="440" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="centerFlow" value="控制与归档流程&#xa;注册初始化 → 校验导入&#xa;→ 去重归档 → 清理复用" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#d9f7be;strokeColor=#52c41a;" parent="center" vertex="1">
                    <mxGeometry x="65" y="85" width="310" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="centerRustfs" value="中心 RustFS&#xa;归档数据 + 全局去重账本" style="shape=cylinder;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#f9f0ff;strokeColor=#722ed1;" parent="center" vertex="1">
                    <mxGeometry x="105" y="230" width="220" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="dash" value="两端各自 Dashboard：HTTP 恢复状态 + 本端 WebSocket 展示实时进度&#xa;WebSocket 不承担 Edge 与 Center 的数据同步" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#f9f0ff;strokeColor=#722ed1;" parent="1" vertex="1">
                    <mxGeometry x="410" y="775" width="1100" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="关键原则：对象数据始终随运输硬盘物理流转；网络只服务于管理、状态和只读查询。" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#52616b;" parent="1" vertex="1">
                    <mxGeometry x="305" y="120" width="1310" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="稳定对象&#xa;只读导出" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#1677ff;fontSize=16;" parent="1" source="edgeRustfs" target="edgeFlow" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="加密后的封盘数据&#xa;（离线写入）" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#fa8c16;fontSize=17;fontStyle=1;" parent="1" source="edgeFlow" target="disk" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="已初始化运输盘&#xa;（物理交付）" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#fa8c16;fontSize=17;fontStyle=1;" parent="1" source="disk" target="edgeFlow" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="510"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e4" value="已封盘运输盘&#xa;（物理运输）" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#fa8c16;fontSize=17;fontStyle=1;" parent="1" source="disk" target="centerFlow" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="初始化 / 清理 / 再初始化&#xa;（中心端负责）" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#52c41a;fontSize=16;fontStyle=1;" parent="1" source="centerFlow" target="disk" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1280" y="510"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e6" value="校验通过的数据&#xa;归档入库" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#52c41a;fontSize=16;" parent="1" source="centerFlow" target="centerRustfs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="encryption-flow-report" name="加密与校验流程">
        <mxGraphModel dx="1795" dy="1535" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="加密与校验：密钥不落盘，数据可验证、可恢复" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#102a43;" parent="1" vertex="1">
                    <mxGeometry x="330" y="50" width="1260" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="edge" value="边缘端：导出时加密" style="swimlane;fontStyle=1;fontSize=22;horizontal=1;startSize=42;fillColor=#e8f4ff;swimlaneFillColor=#ffffff;strokeColor=#1677ff;" parent="1" vertex="1">
                    <mxGeometry x="65" y="160" width="515" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="edgeSecret" value="部署授权密钥&#xa;仅作为派生输入" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#d6e4ff;strokeColor=#1677ff;" parent="edge" vertex="1">
                    <mxGeometry x="65" y="85" width="170" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="edgeContext" value="本次封盘上下文&#xa;运输盘 / 站点 / 任务 / seal 标识" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#d6e4ff;strokeColor=#1677ff;" parent="edge" vertex="1">
                    <mxGeometry x="285" y="85" width="180" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="edgeKdf" value="统一 KDF 派生&#xa;本次 data key&#xa;仅驻留 Edge 内存" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#fffbe6;strokeColor=#faad14;" parent="edge" vertex="1">
                    <mxGeometry x="135" y="230" width="250" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="encrypt" value="逐个数据单元加密&#xa;AES-256-GCM&#xa;PACK 小对象 / FRAMES 大对象分片" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fillColor=#e8f4ff;strokeColor=#1677ff;" parent="edge" vertex="1">
                    <mxGeometry x="105" y="390" width="310" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="edgeNoStore" value="安全边界：不把明文 data key&#xa;或授权密钥写入数据库、硬盘、浏览器" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=#fff1f0;strokeColor=#ff4d4f;" parent="edge" vertex="1">
                    <mxGeometry x="80" y="525" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="endArrow=block;html=1;" parent="edge" source="edgeSecret" target="edgeKdf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="endArrow=block;html=1;" parent="edge" source="edgeContext" target="edgeKdf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="endArrow=block;html=1;" parent="edge" source="edgeKdf" target="encrypt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="disk" value="运输硬盘&#xa;只保存密文与验证信息" style="shape=cylinder3;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=23;fontStyle=1;fillColor=#fff7e6;strokeColor=#fa8c16;" parent="1" vertex="1">
                    <mxGeometry x="735" y="270" width="450" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="diskContent" value="保存：密文、nonce、tag、AAD、SHA256、data_key_id&#xa;以及签名 disk_info、manifest、recovery index&#xa;不保存：明文 data key、授权密钥" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#fffbe6;strokeColor=#faad14;" parent="1" vertex="1">
                    <mxGeometry x="670" y="570" width="580" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="center" value="中心端：导入时校验与解密" style="swimlane;fontStyle=1;fontSize=22;horizontal=1;startSize=42;fillColor=#f6ffed;swimlaneFillColor=#ffffff;strokeColor=#52c41a;" parent="1" vertex="1">
                    <mxGeometry x="1325" y="160" width="530" height="650" as="geometry"/>
                </mxCell>
                <mxCell id="centerSecret" value="授权密钥&#xa;来自中心端权威库" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=#d9f7be;strokeColor=#52c41a;" parent="center" vertex="1">
                    <mxGeometry x="65" y="85" width="170" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="centerContext" value="同一封盘上下文&#xa;从已签名盘面与 manifest 读取" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fillColor=#d9f7be;strokeColor=#52c41a;" parent="center" vertex="1">
                    <mxGeometry x="285" y="85" width="180" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="centerKdf" value="调用同一 KDF&#xa;重新派生相同 data key&#xa;仅驻留 Center 内存" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#fffbe6;strokeColor=#faad14;" parent="center" vertex="1">
                    <mxGeometry x="135" y="230" width="250" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="verify" value="先验证，再解密&#xa;签名 → manifest → SHA256 → AAD&#xa;AES-GCM 认证 → 明文 SHA256" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fillColor=#f6ffed;strokeColor=#52c41a;" parent="center" vertex="1">
                    <mxGeometry x="105" y="390" width="310" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="archive" value="校验通过才归档&#xa;写入对象账本，重复数据跳过" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=#d9f7be;strokeColor=#52c41a;" parent="center" vertex="1">
                    <mxGeometry x="105" y="535" width="310" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="endArrow=block;html=1;" parent="center" source="centerSecret" target="centerKdf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" style="endArrow=block;html=1;" parent="center" source="centerContext" target="centerKdf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" style="endArrow=block;html=1;" parent="center" source="centerKdf" target="verify" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" style="endArrow=block;html=1;" parent="center" source="verify" target="archive" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="密文 + 验证信息" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#fa8c16;fontSize=17;fontStyle=1;" parent="1" source="encrypt" target="disk" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="读取密文 + 验证信息" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#fa8c16;fontSize=17;fontStyle=1;" parent="1" source="disk" target="verify" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ISwd_Azn690PwfX9xl_w-1" value="这里它不直接传输或保存加密密钥，而是让 Edge 和 Center 各自用相同的授权密钥与本次封盘信息，&lt;div&gt;独立计算出同一把临时数据密钥，用于 AES-256-GCM 加密和解密。&lt;br&gt;授权密钥 + 运输盘/任务/封盘标识 → KDF → 本次数据加密密钥&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="700" y="170" width="560" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>