[Unit]
Description=RustFS Transfer Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustfs-transfer
Group=rustfs-transfer
UMask=0000
WorkingDirectory=/opt/rustfs-transfer
ExecStart=/opt/rustfs-transfer/rustfs-transfer-center
EnvironmentFile=-/etc/rustfs-transfer/center.env
Restart=on-failure
RestartSec=5s
StateDirectory=rustfs-transfer/center
LogsDirectory=rustfs-transfer/center
RuntimeDirectory=rustfs-transfer-center
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/rustfs-transfer /var/log/rustfs-transfer /mnt /media /run

[Install]
WantedBy=multi-user.target
