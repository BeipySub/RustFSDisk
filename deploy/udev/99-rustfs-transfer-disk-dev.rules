# Development-only rule for Mutagen-synced Edge source trees.
# Only notify the local daemon to rescan block devices.
# Do not start export, import, cleanup, or reinitialization work from udev.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rustfs-transfer-disk-rescan-dev@%k.service"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rustfs-transfer-disk-rescan-dev@%k.service"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", RUN+="/bin/systemctl --no-block start rustfs-transfer-disk-rescan-dev@%k.service"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", RUN+="/bin/systemctl --no-block start rustfs-transfer-disk-rescan-dev@%k.service"
