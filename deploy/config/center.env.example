# Example only. Replace every CHANGE_ME value through your deployment secret channel.

# Center 配置文件路径；Center 服务启动时读取该 TOML，并允许下面的环境变量覆盖关键字段。
RUSTFS_TRANSFER__CONFIG_PATH=/etc/rustfs-transfer/center.toml

# Center 端 PostgreSQL 连接串；保存运输盘注册、Edge 站点、导入任务、对象账本和密钥包裹信息。
RUSTFS_TRANSFER__DATABASE__URL=postgres://rustfs_transfer_center:CHANGE_ME_PASSWORD@127.0.0.1:5432/rustfs_transfer_center

# Center 本地受控管理 API token；用于需要运维权限的 Center HTTP 接口，不写入前端或日志。
RUSTFS_TRANSFER__SERVER__CONTROL_API_TOKEN=CHANGE_ME_CENTER_CONTROL_API_TOKEN

# RustFS/S3 access key；Center 导入解密后写入归档对象存储时使用。
RUSTFS_TRANSFER__RUSTFS__ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY

# RustFS/S3 secret key；与 access key 配对使用，不得写入日志或前端。
RUSTFS_TRANSFER__RUSTFS__SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY

# Center 本机主密钥；用于加密保存 edge_key 等本地敏感密钥材料，不能更换后直接读取旧密文。
RUSTFS_TRANSFER__SECURITY__LOCAL_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_OR_HEX_KEY

# Center 运输盘签名密钥；用于初始化 disk_info.json 的 center_signature，Edge 识别运输盘时校验该签名。
RUSTFS_TRANSFER__SECURITY__CENTER_SIGNATURE_KEY=CHANGE_ME_32_BYTE_BASE64_OR_HEX_KEY
