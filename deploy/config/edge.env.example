# Edge 服务监听地址
EDGE_BIND=0.0.0.0:8081

# Edge 站点编码，必须和 Center 中创建的站点一致
EDGE_CODE=edge-demo

# Center 生成的 Edge KEY，用于离线鉴权和运输盘密钥派生
EDGE_KEY=CHANGE_ME_EDGE_KEY_FROM_CENTER

# Edge 本地 PostgreSQL，保存导出账本、导出任务和运输盘运行态
DATABASE_URL=postgres://rustfs_transfer_edge:CHANGE_ME_PASSWORD@127.0.0.1:5432/rustfs_transfer_edge

# RustFS / S3 兼容服务地址
RUSTFS_ENDPOINT=http://127.0.0.1:9000

# S3 region，RustFS 本地部署通常用 us-east-1
RUSTFS_REGION=us-east-1

# RustFS 访问凭据；SECRET 如包含 #、$、! 等特殊字符，实际 env 文件里建议加单引号
RUSTFS_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_SECRET_KEY

# Edge 本地数据和日志目录
DATA_DIR=/var/lib/rustfs-transfer/edge
LOG_DIR=/var/log/rustfs-transfer/edge

# 运输盘默认挂载根目录
TRANSPORT_MOUNT_ROOT=/mnt/rustfs-transfer

# Edge 轮询扫描的挂载根目录，多个路径用逗号分隔
DISK_MOUNT_ROOTS=/mnt/rustfs-transfer,/media,/run/media

# 插拔盘识别轮询开关和间隔；开发环境建议 1 秒
DISK_POLLING_ENABLED=true
DISK_POLLING_INTERVAL_SECONDS=1

# 是否开启自动导出；true 表示识别到可用运输盘后允许自动走单盘顺序导出
AUTO_EXPORT_ENABLED=false

# 服务启动或轮询发现 READY 盘后，是否自动启动导出
AUTO_EXPORT_START_ON_READY=false

# 至少有几块 READY 运输盘才允许自动导出；1 表示有 1 块可用盘就开始
AUTO_EXPORT_MIN_READY_DISK_COUNT=1

# 自动导出的冷却时间，单位秒；60 表示 60 秒内不要重复触发一轮自动导出
AUTO_EXPORT_COOLDOWN_SECONDS=60
