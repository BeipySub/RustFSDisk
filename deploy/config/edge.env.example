# Example only. Replace every CHANGE_ME value through your deployment secret channel.
RUSTFS_TRANSFER__CONFIG_PATH=/etc/rustfs-transfer/edge.toml
RUSTFS_TRANSFER__DATABASE__URL=postgres://rustfs_transfer_edge:CHANGE_ME_PASSWORD@127.0.0.1:5432/rustfs_transfer_edge
# Legacy compatibility/audit value only. Edge offline export must not require
# Center reachability through this URL.
RUSTFS_TRANSFER__CENTER__BASE_URL=http://center.example.com:8080
RUSTFS_TRANSFER__CENTER__EDGE_CODE=edge-demo
# Audit identifier for legacy HMAC requests; not required by offline export.
RUSTFS_TRANSFER__CENTER__AUTH_KEY_ID=CHANGE_ME_AUTH_KEY_ID
# Secret-channel placeholder. This value is the offline HMAC derivation input
# for per-seal disk_data_key and must never be logged, served to browsers, or
# written to disk_info/manifest.
RUSTFS_TRANSFER__CENTER__EDGE_AUTH_SECRET=CHANGE_ME_EDGE_AUTH_SECRET
RUSTFS_TRANSFER__SERVER__CONTROL_API_TOKEN=CHANGE_ME_EDGE_CONTROL_API_TOKEN
RUSTFS_TRANSFER__RESCAN__TOKEN=CHANGE_ME_LOCAL_RESCAN_TOKEN
RUSTFS_TRANSFER__RUSTFS__ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
RUSTFS_TRANSFER__RUSTFS__SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY

# Auto export is off by default. Enable only during an approved Edge rollout.
RUSTFS_TRANSFER__AUTO_EXPORT__ENABLED=false
RUSTFS_TRANSFER__AUTO_EXPORT__START_ON_READY=false
RUSTFS_TRANSFER__AUTO_EXPORT__MIN_READY_DISK_COUNT=1
RUSTFS_TRANSFER__AUTO_EXPORT__COOLDOWN_SECONDS=60
