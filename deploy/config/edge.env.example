# Example only. Replace every CHANGE_ME value through your deployment secret channel.

# Edge 后端监听地址和端口；前端代理、SSH 隧道、rescan helper 默认都会连到这个端口。
RUSTFS_TRANSFER__SERVER__BIND=0.0.0.0:8081

# Edge 端 PostgreSQL 连接串；保存扫描快照、导出任务、对象状态和运输盘运行态。
RUSTFS_TRANSFER__DATABASE__URL=postgres://rustfs_transfer_edge:CHANGE_ME_PASSWORD@127.0.0.1:5432/rustfs_transfer_edge

# Edge 站点编码；必须与 Center 端创建的 Edge 站点 edge_code 一致。
RUSTFS_TRANSFER__EDGE__EDGE_CODE=edge-demo

# Center 端生成的 Edge KEY；用于 Edge 向 Center 鉴权，并参与离线 disk_data_key 派生。
RUSTFS_TRANSFER__EDGE__EDGE_KEY=CHANGE_ME_EDGE_KEY_FROM_CENTER

# 本机 udev rescan helper 调用 /internal/disk/rescan 时使用的本地鉴权 token；只在 Edge 本机使用。
RUSTFS_TRANSFER__RESCAN__TOKEN=CHANGE_ME_LOCAL_RESCAN_TOKEN

# RustFS 扫描结果复用窗口，单位分钟；设置为 0 表示每次自动流程都重新扫描 RustFS。
RUSTFS_TRANSFER__SCAN__REUSE_WINDOW_MINUTES=5

# RustFS/S3 兼容服务地址；Edge 只读扫描和导出源对象时访问该地址。
RUSTFS_TRANSFER__RUSTFS__ENDPOINT=http://127.0.0.1:9000

# RustFS/S3 region；兼容 S3 SDK 签名参数，RustFS 本地部署通常可使用 us-east-1。
RUSTFS_TRANSFER__RUSTFS__REGION=us-east-1

# RustFS/S3 access key；Edge 用它读取 bucket/object 列表和对象内容。
RUSTFS_TRANSFER__RUSTFS__ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY

# RustFS/S3 secret key；与 access key 配对使用，不得写入日志或前端。
RUSTFS_TRANSFER__RUSTFS__SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY

# Edge 本地运行数据目录；用于保存服务运行所需的本地文件。
RUSTFS_TRANSFER__PATHS__DATA_DIR=/var/lib/rustfs-transfer/edge

# Edge 本地日志目录；用于保存部署运行日志或辅助诊断文件。
RUSTFS_TRANSFER__PATHS__LOG_DIR=/var/log/rustfs-transfer/edge

# 默认运输盘挂载根目录；用于兼容单根目录配置。
RUSTFS_TRANSFER__PATHS__TRANSPORT_MOUNT_ROOT=/mnt/rustfs-transfer

# Edge 扫描运输盘的挂载根目录列表，多个目录用逗号分隔；插盘后必须挂载在其中一个目录下。
RUSTFS_TRANSFER__PATHS__DISK_MOUNT_ROOTS=/mnt/rustfs-transfer,/media/rustfs-transfer

# Auto export is off by default. Enable only during an approved Edge rollout.

# 是否启用 Edge 自动导出编排；false 时插盘只识别为 READY，不自动扫描和导出。
RUSTFS_TRANSFER__AUTO_EXPORT__ENABLED=false

# 是否在运输盘 READY 后自动启动导出；必须与 AUTO_EXPORT__ENABLED 同时开启才会自动跑主流程。
RUSTFS_TRANSFER__AUTO_EXPORT__START_ON_READY=false

# 自动导出启动所需的最少 READY 运输盘数量；低于该数量时不创建导出任务。
RUSTFS_TRANSFER__AUTO_EXPORT__MIN_READY_DISK_COUNT=1

# 自动导出冷却时间，单位秒；防止连续 udev 事件重复触发扫描和导出。
RUSTFS_TRANSFER__AUTO_EXPORT__COOLDOWN_SECONDS=60
